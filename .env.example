# Paperless-ngx Connection Settings
# URL of your Paperless-ngx instance (internal Docker network URL)
PAPERLESS_URL=http://webserver:8000

# API Token generated from Paperless-ngx Settings -> API Tokens
PAPERLESS_TOKEN=your_paperless_api_token_here

# AnythingLLM Connection Settings
# Use https://useanything.com for cloud or your local instance URL
ANYTHINGLLM_URL=https://useanything.com/api/v1

# API Key generated from AnythingLLM Settings -> API Keys
ANYTHINGLLM_KEY=your_anythingllm_api_key_here

# The workspace slug where your documents are stored (found in workspace settings URL)
WORKSPACE_SLUG=your_workspace_slug_here

# OpenRouter API Settings
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Selection (OpenRouter model slugs)
# All three agents can use the same model or different ones
STUDENT_MODEL=google/gemini-2.5-pro
TEACHER_MODEL=google/gemini-2.5-pro
PROFESSOR_MODEL=google/gemini-2.5-pro

# Triumvirate Loop Hyperparameters
TARGET_POOL_SIZE=10000           # Target number of documents to process
CONCURRENCY_LIMIT=3              # Max concurrent agent conversations (rate limit safe)
SESSION_TURN_LIMIT=3             # Turns per student-teacher dialogue
MIN_PROFESSOR_SCORE=4.0          # Minimum score for a session to be approved

# Google Cloud Storage Settings (optional, for auto-upload)
GCS_BUCKET_NAME=your_gcs_bucket_name_here
GCS_BLOB_PATH=datasets/dataset_gold_standards.jsonl

# Local File Paths (Docker mount points)
DB_PATH=/app/data/curated_documents.db
EXPORT_PATH=/app/data/dataset_gold_standards.jsonl

# Document Quality Assessment Script Settings
# Primary Paperless endpoint (production/VPS - with API token)
PAPERLESS_API_URL=https://paperless.escaffinity.com/api/
PAPERLESS_TOKEN=your_paperless_api_token_here

# Alternative Paperless endpoints for local/development testing
PAPERLESS_LOCAL_URL=http://localhost:8010/api/
PAPERLESS_DOCKER_URL=http://paperless-webserver:8000/api/

# Mac Mini LM Studio endpoint for Gemma inference (Tailscale address)
MAC_MINI_LM_STUDIO=http://100.119.61.113:1234/v1
GEMMA_MODEL=gemma-2-9b-it
